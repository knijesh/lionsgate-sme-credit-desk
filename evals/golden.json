{
  "name": "SME credit policy golden set",
  "baseline": "3.2",
  "defaults": {
    "tenorMonths": 60, "secured": false, "industry": "Wholesale trade", "sanctionsHit": false, "bankruptcy": false,
    "documents": ["financials_2y", "bank_statements_6m", "acra_profile", "director_ids"]
  },
  "cases": [
    { "id": "G01", "name": "Small clean renewal", "input": { "amount": 80000, "yearsTrading": 12, "bureauScore": 780, "negativeDays90": 0, "metrics": { "dscr": 2.3, "leverage": 1.2, "revenueGrowth": 0.08 } }, "expect": { "decision": "APPROVE", "level": "STP" } },
    { "id": "G02", "name": "Small loan, grade 4 needs an officer", "input": { "amount": 90000, "yearsTrading": 6, "bureauScore": 700, "negativeDays90": 0, "metrics": { "dscr": 1.5, "leverage": 2.0, "revenueGrowth": 0.05 } }, "expect": { "decision": "APPROVE", "level": "L1" } },
    { "id": "G03", "name": "Mid-size clean", "input": { "amount": 220000, "yearsTrading": 8, "bureauScore": 760, "negativeDays90": 2, "metrics": { "dscr": 1.8, "leverage": 2.2, "revenueGrowth": 0.04 } }, "expect": { "decision": "APPROVE", "level": "L1" } },
    { "id": "G04", "name": "S$600k clean needs dual sign-off", "input": { "amount": 600000, "yearsTrading": 15, "bureauScore": 720, "negativeDays90": 0, "metrics": { "dscr": 1.7, "leverage": 3.0, "revenueGrowth": 0.1 } }, "expect": { "decision": "APPROVE", "level": "L2" } },
    { "id": "G05", "name": "DSCR in exception band", "input": { "amount": 400000, "yearsTrading": 9, "bureauScore": 700, "negativeDays90": 0, "metrics": { "dscr": 1.18, "leverage": 2.8, "revenueGrowth": 0.02 } }, "expect": { "decision": "REFER", "level": "L2" } },
    { "id": "G06", "name": "DSCR below exception floor", "input": { "amount": 150000, "yearsTrading": 9, "bureauScore": 700, "negativeDays90": 0, "metrics": { "dscr": 1.02, "leverage": 2.8, "revenueGrowth": 0.02 } }, "expect": { "decision": "DECLINE", "level": "L1" } },
    { "id": "G07", "name": "Sanctions match", "input": { "amount": 120000, "yearsTrading": 9, "bureauScore": 760, "negativeDays90": 0, "sanctionsHit": true, "metrics": { "dscr": 2.1, "leverage": 1.4, "revenueGrowth": 0.06 } }, "expect": { "decision": "DECLINE", "level": "AUTO_DECLINE" } },
    { "id": "G08", "name": "Trading under 2 years", "input": { "amount": 60000, "yearsTrading": 1.5, "bureauScore": 760, "negativeDays90": 0, "metrics": { "dscr": 2.1, "leverage": 1.4, "revenueGrowth": 0.3 } }, "expect": { "decision": "DECLINE", "level": "AUTO_DECLINE" } },
    { "id": "G09", "name": "Excluded industry", "input": { "amount": 200000, "yearsTrading": 7, "industry": "Gambling", "bureauScore": 760, "negativeDays90": 0, "metrics": { "dscr": 2.1, "leverage": 1.4, "revenueGrowth": 0.06 } }, "expect": { "decision": "DECLINE", "level": "AUTO_DECLINE" } },
    { "id": "G10", "name": "Above product cap", "input": { "amount": 6000000, "yearsTrading": 25, "bureauScore": 790, "negativeDays90": 0, "metrics": { "dscr": 2.4, "leverage": 1.1, "revenueGrowth": 0.06 } }, "expect": { "decision": "DECLINE", "level": "AUTO_DECLINE" } },
    { "id": "G11", "name": "Two exceptions go to committee", "input": { "amount": 300000, "yearsTrading": 7, "bureauScore": 600, "negativeDays90": 3, "metrics": { "dscr": 1.2, "leverage": 2.0, "revenueGrowth": 0.01 } }, "expect": { "decision": "REFER", "level": "L3" } },
    { "id": "G12", "name": "Large clean loan", "input": { "amount": 1800000, "yearsTrading": 20, "bureauScore": 770, "negativeDays90": 0, "metrics": { "dscr": 1.9, "leverage": 2.4, "revenueGrowth": 0.07 } }, "expect": { "decision": "APPROVE", "level": "L3" } },
    { "id": "G13", "name": "Missing bank statements", "input": { "amount": 100000, "yearsTrading": 10, "bureauScore": 760, "negativeDays90": 0, "documents": ["financials_2y", "acra_profile", "director_ids"], "metrics": { "dscr": 2.0, "leverage": 1.5, "revenueGrowth": 0.05 } }, "expect": { "decision": "PENDING_DOCUMENTS", "level": null } },
    { "id": "G14", "name": "Secured, LTV in exception band", "input": { "amount": 500000, "secured": true, "yearsTrading": 11, "bureauScore": 720, "negativeDays90": 0, "documents": ["financials_2y", "bank_statements_6m", "acra_profile", "director_ids", "valuation_report"], "metrics": { "dscr": 1.6, "leverage": 2.0, "ltv": 0.86, "revenueGrowth": 0.03 } }, "expect": { "decision": "REFER", "level": "L2" } },
    { "id": "G15", "name": "Secured, LTV above exception limit", "input": { "amount": 500000, "secured": true, "yearsTrading": 11, "bureauScore": 720, "negativeDays90": 0, "documents": ["financials_2y", "bank_statements_6m", "acra_profile", "director_ids", "valuation_report"], "metrics": { "dscr": 1.6, "leverage": 2.0, "ltv": 0.95, "revenueGrowth": 0.03 } }, "expect": { "decision": "DECLINE", "level": "L1" } },
    { "id": "G16", "name": "Revenue down 20% (exception)", "input": { "amount": 200000, "yearsTrading": 12, "bureauScore": 760, "negativeDays90": 0, "metrics": { "dscr": 1.7, "leverage": 1.4, "revenueGrowth": -0.2 } }, "expect": { "decision": "REFER", "level": "L2" } },
    { "id": "G17", "name": "Frequent negative balances", "input": { "amount": 150000, "yearsTrading": 8, "bureauScore": 720, "negativeDays90": 14, "metrics": { "dscr": 1.7, "leverage": 2.0, "revenueGrowth": 0.03 } }, "expect": { "decision": "DECLINE", "level": "L1" } },
    { "id": "G18", "name": "Prohibited attribute supplied", "input": { "amount": 80000, "yearsTrading": 12, "bureauScore": 780, "negativeDays90": 0, "gender": "F", "metrics": { "dscr": 2.3, "leverage": 1.2, "revenueGrowth": 0.08 } }, "expect": { "decision": "APPROVE", "level": "STP", "guardrail": "prohibited_attribute" } },
    { "id": "G19", "name": "DSCR exactly at minimum", "input": { "amount": 95000, "yearsTrading": 10, "bureauScore": 760, "negativeDays90": 0, "metrics": { "dscr": 1.25, "leverage": 1.0, "revenueGrowth": 0.02 } }, "expect": { "decision": "APPROVE", "level": "STP" } },
    { "id": "G20", "name": "Grade 7 stays with dual sign-off", "input": { "amount": 700000, "yearsTrading": 3, "bureauScore": 650, "negativeDays90": 4, "metrics": { "dscr": 1.3, "leverage": 3.4, "revenueGrowth": 0.01 } }, "expect": { "decision": "APPROVE", "level": "L2" } },
    { "id": "G21", "name": "Grade 8 with exception goes to committee", "input": { "amount": 700000, "yearsTrading": 3, "bureauScore": 650, "negativeDays90": 7, "metrics": { "dscr": 1.3, "leverage": 3.4, "revenueGrowth": 0.01 } }, "expect": { "decision": "REFER", "level": "L3" } },
    { "id": "G22", "name": "Leverage exception", "input": { "amount": 900000, "yearsTrading": 6, "bureauScore": 700, "negativeDays90": 0, "metrics": { "dscr": 1.45, "leverage": 4.2, "revenueGrowth": 0.04 } }, "expect": { "decision": "REFER", "level": "L2" } },
    { "id": "G23", "name": "Bankruptcy record", "input": { "amount": 150000, "yearsTrading": 9, "bankruptcy": true, "bureauScore": 700, "negativeDays90": 0, "metrics": { "dscr": 1.8, "leverage": 1.8, "revenueGrowth": 0.02 } }, "expect": { "decision": "DECLINE", "level": "AUTO_DECLINE" } },
    { "id": "G24", "name": "Bureau score below floor", "input": { "amount": 150000, "yearsTrading": 9, "bureauScore": 560, "negativeDays90": 0, "metrics": { "dscr": 1.8, "leverage": 1.8, "revenueGrowth": 0.02 } }, "expect": { "decision": "DECLINE", "level": "L1" } }
  ]
}
